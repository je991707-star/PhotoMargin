<Window x:Class="PhotoMargin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PhotoMargin">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="SectionDividerBrush" Color="#22000000" />
                        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#0D000000" />
                        <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#EEEEEE" />
                        <SolidColorBrush x:Key="BrandPreviewBrush" Color="#DDDDDD" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="SectionDividerBrush" Color="#22FFFFFF" />
                        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#2B2B2B" />
                        <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#2B2B2B" />
                        <SolidColorBrush x:Key="BrandPreviewBrush" Color="#D9D9D9" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="SectionDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="BrandPreviewBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                    <Setter Property="FontSize" Value="22" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid x:Name="WorkspaceGrid">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="12,4" MinHeight="64">
                <Button x:Name="SettingsButton" Padding="8" HorizontalAlignment="Left" Background="Transparent"
                        BorderThickness="0" Click="Settings_Click" AutomationProperties.Name="設定" ToolTipService.ToolTip="設定">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Padding="12,0,4,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="0.49*" MinWidth="320" MaxWidth="460" /></Grid.ColumnDefinitions>
                <Border x:Name="PreviewSurface" Background="{ThemeResource PreviewSurfaceBrush}" CornerRadius="10" Padding="16,24,16,12"
                        AllowDrop="True" DragOver="Preview_DragOver" Drop="Preview_Drop">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Viewbox x:Name="PreviewViewport" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed">
                            <Grid x:Name="PreviewCanvas" Width="1080" Height="1080" Background="White">
                                <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="正方形成品預覽" />
                            </Grid>
                        </Viewbox>
                        <Viewbox x:Name="EmptyPhotoState" Stretch="Uniform" MaxWidth="600" MaxHeight="280" Margin="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Width="600" Spacing="24" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7AA;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="104"
                                          HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="拖入 PNG / JPG 照片" FontSize="32" TextAlignment="Center" />
                                <Button x:Name="SelectPhotoButton" Click="ChangePhoto_Click" IsEnabled="{Binding CanSelectPhoto}"
                                        HorizontalAlignment="Center" MinWidth="120" Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="選擇 JPG 或 PNG 照片" AutomationProperties.Name="匯入照片">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="匯入照片" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Viewbox>
                        <ProgressRing Width="40" Height="40" IsActive="{Binding IsBusy}" />
                        <TextBlock x:Name="SourceSummaryText" Grid.Row="1" Text="{Binding PreviewCaption}" FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding PreviewCaption}"
                                   ToolTipService.ToolTip="{Binding PreviewCaption}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <ContentControl x:Name="SidebarSettingsHost" IsEnabled="{Binding HasPhoto}" IsTabStop="False"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel x:Name="SidebarContent" Spacing="12" Margin="0,8,12,0">
                            <TextBlock Text="預覽與輸出" Style="{StaticResource SectionTitleStyle}" />
                            <CheckBox x:Name="GuidesCheckBox" Content="顯示裁切與安全線" IsChecked="{Binding ShowGuides, Mode=TwoWay}" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="OutputSizeBox" Header="顯示尺寸" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="OutputSize_SelectionChanged">
                                    <ComboBoxItem Content="1080" /><ComboBoxItem Content="2048" /><ComboBoxItem Content="自訂" />
                                </ComboBox>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="JPG 品質" />
                                    <Slider x:Name="JpegQualitySlider" AutomationProperties.Name="JPG 品質" Minimum="50" Maximum="100" StepFrequency="1"
                                            TickFrequency="5" TickPlacement="BottomRight" Value="{Binding JpegQuality, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <NumberBox x:Name="CustomOutputSizeBox" Header="自訂正方形尺寸（px）" Visibility="Collapsed" Minimum="320" Maximum="8192"
                                       Value="{Binding OutputSize, Mode=TwoWay}" />
                            <Rectangle Height="1" Fill="{ThemeResource SectionDividerBrush}" Margin="0,2" />
                            <TextBlock Text="照片版面" Style="{StaticResource SectionTitleStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="MarginRuleBox" Header="邊距設定" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          ItemsSource="{Binding MarginRules}" SelectedValue="{Binding SelectedMarginRuleId, Mode=TwoWay}" />
                                <Button x:Name="AddRuleButton" Grid.Column="1" Content="新增規則" Click="AddRule_Click" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <ComboBox x:Name="BrandImageBox" Header="品牌圖設定" HorizontalAlignment="Stretch" IsEnabled="False" SelectedIndex="0"
                                      AutomationProperties.Name="品牌圖設定，暫未開放此功能"><ComboBoxItem Content="暫未開放此功能" /></ComboBox>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="102" /></Grid.ColumnDefinitions>
                                <Grid RowSpacing="12" ColumnSpacing="16">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CameraFontSizeBox" Header="機身字級" IsEditable="True" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontSizes}" SelectedItem="{Binding PrimaryFontSize, Mode=TwoWay}" />
                                    <ComboBox x:Name="LensFontSizeBox" Grid.Column="1" Header="鏡頭字級" IsEditable="True" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontSizes}" SelectedItem="{Binding LensFontSize, Mode=TwoWay}" />
                                    <ComboBox x:Name="InfoFontSizeBox" Grid.Row="1" Header="資訊字級" IsEditable="True" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SecondaryFontSize, Mode=TwoWay}" />
                                    <ComboBox x:Name="DateFontSizeBox" Grid.Row="1" Grid.Column="1" Header="時間字級" IsEditable="True" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding FontSizes}" SelectedItem="{Binding DateFontSize, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="品牌圖預覽" FontSize="14" />
                                    <Border x:Name="BrandPreview" Height="102" CornerRadius="4" Background="{ThemeResource BrandPreviewBrush}"
                                            AutomationProperties.Name="品牌圖預覽，功能未開放" />
                                </StackPanel>
                            </Grid>
                            <ComboBox x:Name="FontFamilyBox" Header="字體設定" IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding FontChoices}"
                                      SelectedItem="{Binding FontFamily, Mode=TwoWay}" />
                            <Rectangle Height="1" Fill="{ThemeResource SectionDividerBrush}" Margin="0,2" />
                            <Grid>
                                <TextBlock Text="照片資訊" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <Button x:Name="ReloadExifButton" HorizontalAlignment="Right" Padding="8" Background="Transparent" BorderThickness="0"
                                        Click="ReloadExif_Click" IsEnabled="{Binding CanReload}" ToolTipService.ToolTip="重新讀取照片資訊"
                                        AutomationProperties.Name="重新讀取照片資訊"><SymbolIcon Symbol="Refresh" /></Button>
                            </Grid>
                            <TextBox x:Name="CameraTextBox" Header="機身" Text="{Binding Camera, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox x:Name="LensTextBox" Header="鏡頭" Text="{Binding Lens, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="拍攝時間" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CalendarDatePicker x:Name="PhotoDatePicker" MinWidth="0" HorizontalAlignment="Stretch" PlaceholderText="選擇日期" CalendarIdentifier="GregorianCalendar"
                                                        Date="{x:Bind ViewModel.SelectedDate, Mode=TwoWay}" AutomationProperties.Name="拍攝日期" />
                                    <TimePicker x:Name="PhotoTimePicker" Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock"
                                                SelectedTime="{x:Bind ViewModel.SelectedTime, Mode=TwoWay}" AutomationProperties.Name="拍攝時間"
                                                Loaded="PhotoTimePicker_Loaded" ActualThemeChanged="PhotoTimePicker_ActualThemeChanged" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <NumberBox x:Name="FocalLengthBox" Header="焦距 mm" MinWidth="0" Minimum="0" Maximum="10000" SmallChange="1" Value="{Binding FocalLengthValue, Mode=TwoWay}" />
                                <NumberBox x:Name="ApertureBox" Grid.Column="1" Header="光圈 f/" MinWidth="0" Minimum="0" Maximum="256" SmallChange="0.1" Value="{Binding ApertureValue, Mode=TwoWay}" />
                                <TextBox x:Name="ShutterTextBox" Grid.Column="2" Header="快門 s" MinWidth="0" Text="{Binding ShutterInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox x:Name="IsoBox" Grid.Column="3" Header="ISO" MinWidth="0" Minimum="0" Maximum="10000000" SmallChange="100" Value="{Binding IsoValue, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                        </ContentControl>
                    </ScrollViewer>
                    <StackPanel x:Name="PhotoActions" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,0,12,8">
                        <Button x:Name="ChangePhotoButton" Click="ChangePhoto_Click" IsEnabled="{Binding CanSelectPhoto}" Visibility="Collapsed" ToolTipService.ToolTip="選擇或更換照片">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="更換照片" /></StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="{Binding CanExport}" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Save" /><TextBlock Text="匯出圖片" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Row="2" Background="{ThemeResource StatusBackgroundBrush}" Padding="16,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid ColumnSpacing="12" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SourceFileName}" TextTrimming="CharacterEllipsis" MaxWidth="300" FontSize="14" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding SourceFileSizeText}" FontSize="14" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding ApplicationIdentity}" FontSize="14" VerticalAlignment="Center" />
            </Grid>
        </Grid>
        <Frame x:Name="SettingsFrame" Visibility="Collapsed" />
    </Grid>
</Window>
