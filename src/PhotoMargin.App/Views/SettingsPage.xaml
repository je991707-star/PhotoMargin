<Page x:Class="PhotoMargin.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#272727" /><SolidColorBrush x:Key="PresetPreviewBrush" Color="#202020" /></ResourceDictionary>
                <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SettingsSurfaceBrush" Color="#FAFAFA" /><SolidColorBrush x:Key="PresetPreviewBrush" Color="#EEEEEE" /></ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="SettingsSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" /><SolidColorBrush x:Key="PresetPreviewBrush" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Page.KeyboardAccelerators><KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" /></Page.KeyboardAccelerators>
    <Grid>
    <NavigationView x:Name="SettingsNavigation" PaneDisplayMode="Auto" OpenPaneLength="320" IsPaneOpen="True"
                    ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640" AlwaysShowHeader="False"
                    IsSettingsVisible="False" IsBackButtonVisible="Visible" IsBackEnabled="True"
                    BackRequested="Navigation_BackRequested" SelectionChanged="Navigation_SelectionChanged"
                    DisplayModeChanged="Navigation_DisplayModeChanged">
        <NavigationView.PaneHeader><Grid x:Name="PaneHeaderSpace" Height="0" /></NavigationView.PaneHeader>
        <NavigationView.AutoSuggestBox>
            <AutoSuggestBox x:Name="SettingsSearch" PlaceholderText="Search" QueryIcon="Find" TextChanged="Search_TextChanged"
                            AutomationProperties.Name="搜尋設定導覽項目" />
        </NavigationView.AutoSuggestBox>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="GeneralItem" Content="一般設定" Tag="General"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="LayoutItem" Content="版面設定" Tag="Layout"><NavigationViewItem.Icon><SymbolIcon Symbol="Page" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="CameraItem" Content="相機資訊設定" Tag="Camera"><NavigationViewItem.Icon><SymbolIcon Symbol="Camera" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="ExportItem" Content="匯出設定" Tag="Export"><NavigationViewItem.Icon><SymbolIcon Symbol="Save" /></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <Border Background="{ThemeResource SettingsSurfaceBrush}" CornerRadius="4,0,0,0" Margin="0,8,0,0">
            <Grid>
            <ScrollViewer x:Name="CommonSettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,24,16" HorizontalContentAlignment="Stretch" SizeChanged="CommonSettingsScroller_SizeChanged">
                <Grid x:Name="SettingsContentHost">
                <Grid x:Name="CommonSettingsBody" MaxWidth="720" HorizontalAlignment="Left">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="GeneralContent" Spacing="20">
                        <TextBlock Text="一般設定" Style="{ThemeResource TitleTextBlockStyle}" />
                        <ComboBox x:Name="ThemeOptions" Header="色彩模式" HorizontalAlignment="Stretch" ItemsSource="{Binding ColorModes}" SelectedIndex="{Binding ColorModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanManageData}" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="資料與設定" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="DataLocationText" Header="資料位置" Text="{Binding DataDirectory, Mode=OneWay}" IsReadOnly="True" ToolTipService.ToolTip="{Binding DataDirectory}" />
                            <Button Grid.Column="1" Content="開啟資料夾" VerticalAlignment="Bottom" Click="OpenDataFolder_Click" IsEnabled="{Binding CanManageData}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="ExportSettingsBundleButton" Content="匯出設定集" Click="ExportSettingsBundle_Click" IsEnabled="{Binding CanManageData}" />
                            <Button x:Name="ImportSettingsBundleButton" Content="匯入設定集" Click="ImportSettingsBundle_Click" IsEnabled="{Binding CanManageData}" />
                            <ProgressRing Width="24" Height="24" IsActive="{Binding IsDataBusy}" AutomationProperties.Name="正在處理設定集" />
                        </StackPanel>
                        <TextBlock Text="備份或移轉個人設定與預設。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DataStatusText" Text="{Binding DataStatus}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding DataStatus}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="CameraContent" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="相機資訊設定" Style="{ThemeResource TitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ReadRawInformationButton" Content="從 RAW 檔讀取 EXIF" Click="ReadRawInformation_Click" IsEnabled="{Binding CanReadRaw}" Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="匯入修圖前RAW檔，補充缺失資訊" AutomationProperties.Name="從 RAW 檔讀取 EXIF" />
                        <ProgressRing IsActive="{Binding IsRawReading}" Width="24" Height="24" HorizontalAlignment="Left" AutomationProperties.Name="正在讀取 RAW 拍攝資訊" />
                        </StackPanel>
                        <TextBlock x:Name="AppliedInformationFileText" Text="{Binding RawSourceDescription}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <StackPanel x:Name="RawActionButtons" Orientation="Horizontal" Spacing="12" SizeChanged="RawActions_SizeChanged">
                            <Button x:Name="ReloadRawInformationButton" Content="重新讀取 RAW 檔 EXIF" Click="ReloadRawInformation_Click" IsEnabled="{Binding CanReloadRaw}" Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" ToolTipService.ToolTip="重新讀取目前RAW檔" AutomationProperties.Name="重新讀取 RAW 檔 EXIF" />
                            <Button x:Name="RestorePhotoExifButton" Content="{Binding RestorePhotoExifLabel}" Click="RestorePhotoExif_Click" IsEnabled="{Binding CanRestorePhotoExif}"
                                    HorizontalAlignment="Left" ToolTipService.ToolTip="還原作品照片原本的 EXIF" AutomationProperties.Name="{Binding RestorePhotoExifLabel}" />
                        </StackPanel>
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="目前拍攝資訊" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                <TextBlock Text="欄位" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="目前內容" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="來源" FontWeight="SemiBold" />
                            </Grid>
                            <ItemsControl x:Name="CameraInformationRows" ItemsSource="{Binding InformationRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="16" Padding="0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Grid.Column="2" Text="{Binding Source}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="ExportContent" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="匯出設定" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="格式與尺寸" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="SettingsExportFormatBox" Header="輸出格式" HorizontalAlignment="Stretch" ItemsSource="{Binding ExportFormats}" SelectedIndex="{Binding ExportFormatIndex, Mode=TwoWay}" />
                        <ComboBox x:Name="SettingsExportSizeBox" Header="輸出尺寸" HorizontalAlignment="Stretch" ItemsSource="{Binding ExportSizes}" SelectedIndex="{Binding ExportSizeIndex, Mode=TwoWay}" />
                        <NumberBox x:Name="ExportCustomSizeBox" Header="自訂尺寸（px）" Minimum="320" Maximum="8192" SmallChange="1" Value="{Binding OutputSize, Mode=TwoWay}"
                                   Visibility="{Binding ShowCustomExportSize, Converter={StaticResource BoolVisibility}}" ToolTipService.ToolTip="正方形單邊像素，320～8192。" />
                        <StackPanel Spacing="6">
                            <Grid><TextBlock Text="品質" /><TextBlock Text="{Binding ExportQualityText}" HorizontalAlignment="Right" /></Grid>
                            <Slider x:Name="SettingsExportQualitySlider" Minimum="1" Maximum="100" StepFrequency="1" Value="{Binding ExportQuality, Mode=TwoWay}" AutomationProperties.Name="品質"
                                    Visibility="{Binding ShowExportQuality, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Text="無損" Visibility="{Binding ShowExportLossless, Converter={StaticResource BoolVisibility}}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WebpLosslessSwitch" Header="WebP 無損" OnContent="開啟" OffContent="關閉" IsOn="{Binding WebpLossless, Mode=TwoWay}" Visibility="{Binding ShowWebpOptions, Converter={StaticResource BoolVisibility}}" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="儲存" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Header="儲存位置" IsReadOnly="True" Text="{Binding ExportDirectory, Mode=OneWay}" PlaceholderText="未指定時，匯出時選擇" ToolTipService.ToolTip="{Binding ExportDirectory}" />
                            <Button Grid.Column="1" Content="選擇資料夾" VerticalAlignment="Bottom" Click="ChooseExportDirectory_Click" />
                        </Grid>
                        <ComboBox Header="檔名規則" HorizontalAlignment="Stretch" ItemsSource="{Binding FileNameModes}" SelectedIndex="{Binding FileNameMode, Mode=TwoWay}" />
                        <TextBox Header="自訂規則" Text="{Binding FileNamePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowCustomFileName, Converter={StaticResource BoolVisibility}}"
                                 ToolTipService.ToolTip="{}{name}：原檔名；{date}：拍攝日期 yyyyMMdd，缺少時使用匯出日期。" />
                        <TextBlock Text="{Binding FileNameExample}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox Header="同名檔案" HorizontalAlignment="Stretch" ItemsSource="{Binding ConflictModes}" SelectedIndex="{Binding ConflictMode, Mode=TwoWay}" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="拍攝資訊" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <CheckBox Content="保留拍攝資訊" IsChecked="{Binding IncludeExportMetadata, Mode=TwoWay}" ToolTipService.ToolTip="將機身、鏡頭與拍攝參數寫入檔案。" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock Text="完成後" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <CheckBox Content="匯出後開啟資料夾" IsChecked="{Binding OpenExportFolder, Mode=TwoWay}" />
                        <CheckBox Content="記住匯出位置" IsChecked="{Binding RememberExportLocation, Mode=TwoWay}" />
                        <TextBlock Text="裁切與安全線不會寫入成品。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding PersistenceError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                </Grid>
            </ScrollViewer>
            <Grid x:Name="LayoutContent" Padding="24,24,12,24" RowSpacing="40" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="版面設定" Style="{ThemeResource TitleTextBlockStyle}" />
                <Grid x:Name="PresetWorkspace" Grid.Row="1" ColumnSpacing="20" RowSpacing="16" SizeChanged="PresetWorkspace_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="PresetPreviewColumn" Width="*" /><ColumnDefinition x:Name="PresetControlsColumn" Width="0.46*" MinWidth="240" MaxWidth="360" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition x:Name="PresetPreviewRow" Height="*" /><RowDefinition x:Name="PresetControlsRow" Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="PresetPreviewSurface" Background="{ThemeResource PresetPreviewBrush}" CornerRadius="4" Padding="30">
                        <Viewbox x:Name="PresetPreviewViewbox" Stretch="Uniform">
                            <Grid Width="1080" Height="1080" Background="White">
                                <Image x:Name="RulePreviewImage" Stretch="Uniform" AutomationProperties.Name="目前作品版面預覽" />
                            </Grid>
                        </Viewbox>
                    </Border>
                    <ScrollViewer x:Name="PresetControlsScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,12,0">
                        <StackPanel Spacing="12">
                            <ComboBox x:Name="RuleEditorSelector" Header="邊距規則" HorizontalAlignment="Stretch" ItemsSource="{Binding MarginRules}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RuleEditor.SelectedRuleId, Mode=OneWay}"
                                      IsEnabled="{Binding RuleEditor.CanEdit}" SelectionChanged="RuleSelection_Changed" />
                            <ComboBox x:Name="ImageAspectSelector" Header="圖片比例" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RuleEditor.AspectChoices}" SelectedIndex="{Binding RuleEditor.AspectIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding RuleEditor.CanEdit}" AutomationProperties.Name="圖片比例" />
                            <ComboBox x:Name="InformationArrangementSelector" Header="排列設定" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RuleEditor.ArrangementChoices}" SelectedIndex="{Binding RuleEditor.ArrangementIndex, Mode=TwoWay}"
                                      IsEnabled="{Binding RuleEditor.CanEdit}" AutomationProperties.Name="排列設定" />
                            <RadioButtons x:Name="RuleModeOptions" Header="規則編輯模式" MaxColumns="1" SelectedIndex="{Binding RuleEditor.ModeIndex, Mode=OneWay}"
                                          IsEnabled="{Binding RuleEditor.CanEdit}" SelectionChanged="RuleMode_Changed">
                                <x:String>套用預設內容</x:String><x:String>編輯預設內容</x:String>
                            </RadioButtons>
                            <ContentControl IsEnabled="{Binding RuleEditor.CanAdjustValues}" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="PresetNameBox" Header="規則名稱" MaxLength="60" Text="{Binding RuleEditor.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="左右邊距" /><TextBlock x:Name="SideMarginValue" Grid.Column="1" Text="{Binding RuleEditor.SideText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="SideMarginSlider" Minimum="0" Maximum="400" StepFrequency="1" Value="{Binding RuleEditor.Side, Mode=TwoWay}" AutomationProperties.Name="左右邊距（1080 基準 px）" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="上方邊距" /><TextBlock Grid.Column="1" Text="{Binding RuleEditor.TopText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="TopMarginSlider" Minimum="0" Maximum="400" StepFrequency="1" Value="{Binding RuleEditor.Top, Mode=TwoWay}" AutomationProperties.Name="上方邊距（1080 基準 px）" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="下方邊距" /><TextBlock Grid.Column="1" Text="{Binding RuleEditor.BottomText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="BottomMarginSlider" Minimum="0" Maximum="540" StepFrequency="1" Value="{Binding RuleEditor.Bottom, Mode=TwoWay}" AutomationProperties.Name="下方邊距（1080 基準 px）" ToolTipService.ToolTip="可見文字最下緣到完整畫布底邊的距離；明確啟用的上下裁切保護仍優先。" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="照片與文字間隔" /><TextBlock Grid.Column="1" Text="{Binding RuleEditor.GapText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="InformationGapSlider" Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding RuleEditor.Gap, Mode=TwoWay}" AutomationProperties.Name="照片與文字間隔（1080 基準 px）" ToolTipService.ToolTip="照片下邊緣與最上方可見文字之間的垂直距離。" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="焦距、曝光三要素間隔" TextWrapping="Wrap" /><TextBlock x:Name="ExposureItemGapValue" Grid.Column="1" Text="{Binding RuleEditor.ExposureItemGapText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="ExposureItemGapSlider" Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding RuleEditor.ExposureItemGap, Mode=TwoWay}" AutomationProperties.Name="焦距、曝光三要素間隔（1080 基準 px）" ToolTipService.ToolTip="焦距、光圈、快門、ISO 相鄰可見項目的水平距離；不改字距或行距。" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="文字與左右邊界" /><TextBlock Grid.Column="1" Text="{Binding RuleEditor.ExtraText}" TextAlignment="Right" /></Grid>
                                        <Slider x:Name="ExtraPaddingSlider" Minimum="0" Maximum="200" StepFrequency="1" Value="{Binding RuleEditor.Extra, Mode=TwoWay}" AutomationProperties.Name="文字與左右邊界（1080 基準 px）" ToolTipService.ToolTip="從裁切可見區的左右邊界向內保留距離，只影響文字可用寬度，不內縮上下邊界。" />
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>
                            <Grid ColumnSpacing="12" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="SaveRuleButton" MinWidth="100" Content="儲存預設" Click="SaveRule_Click" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding RuleEditor.CanSave}" />
                                <Button x:Name="DeleteRuleButton" Grid.Column="1" MinWidth="100" Content="刪除預設" Click="DeleteRule_Click" IsEnabled="{Binding RuleEditor.CanDelete}">
                                    <Button.Resources><ResourceDictionary Source="ms-appx:///Views/DangerButtonResources.xaml" /></Button.Resources>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding RuleEditor.Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding RuleEditor.PreviewError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            </Grid>
        </Border>
    </NavigationView>
    <StackPanel x:Name="SettingsHeaderButtons" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8,8,0,0" Visibility="Collapsed">
        <Button x:Name="SettingsBackButton" Click="HeaderBack_Click" Background="Transparent" BorderThickness="0" Padding="12,8" TabIndex="0"
                ToolTipService.ToolTip="返回" AutomationProperties.Name="返回"><SymbolIcon Symbol="Back" /></Button>
        <Button x:Name="SettingsPaneToggleButton" Click="HeaderPaneToggle_Click" Background="Transparent" BorderThickness="0" Padding="12,8" TabIndex="1"
                ToolTipService.ToolTip="收合設定導覽" AutomationProperties.Name="收合設定導覽"><SymbolIcon Symbol="GlobalNavigationButton" /></Button>
    </StackPanel>
    </Grid>
</Page>
